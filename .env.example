# Copy this file to .env (same folder) and fill in the channel you use. Keep .env private: it holds tokens.

# ---------- Telegram (see TELEGRAM.md) ----------
# Token from @BotFather in Telegram, e.g. 123456789:AA...
TELEGRAM_TOKEN=

# ---------- WhatsApp (see WHATSAPP.md) ----------
# Values come from developers.facebook.com → your app → WhatsApp → API Setup.

# Temporary or system-user access token
WA_TOKEN=
# "Phone number ID" of the test number (not the phone number itself)
WA_PHONE_NUMBER_ID=
# Any random string you make up; paste the same value as the "Verify token" in the webhook settings
WA_VERIFY_TOKEN=
# App settings → Basic → App secret. Used to check that webhook calls really come from Meta
WA_APP_SECRET=

# Optional
# Graph API version to call; use the version shown in your app dashboard if this one is retired
WA_API_VERSION=v23.0
# Approved utility template for updates sent more than 24 hours after the customer's last message.
# Body with two parameters, for example: "SecondStitch update for order {{1}}: {{2}}."
WA_STATUS_TEMPLATE=
WA_TEMPLATE_LANG=en
# Port for the webhook listener (tunnel this port, not the website port)
WA_WEBHOOK_PORT=8081
